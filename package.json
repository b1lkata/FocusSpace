{
  "name": "focusspace",
  "version": "0.2.7",
  "private": true,
  "description": "Tuniko - a music discovery and listening prototype.",
  "main": "dist/main/main.cjs",
  "scripts": {
    "music:backend": "node scripts/music-backend.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke.mjs",
    "test:hardening": "node scripts/hardening-smoke.mjs",
    "lint": "eslint src tests",
    "package": "npm run build && electron-builder --win dir",
    "test:usability": "node scripts/usability-smoke.mjs",
    "build:web": "tsc --noEmit && vite build --mode web-preview",
    "preview:web": "node scripts/preview-server.mjs",
    "web": "npm run build:web && npm run preview:web",
    "test:web": "node scripts/web-preview-smoke.mjs",
    "test:design": "node scripts/living-design-smoke.mjs",
    "test:music": "node scripts/music-smoke.mjs",
    "build:ios": "tsc --noEmit && vite build --mode ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "build:android": "tsc --noEmit && vite build --mode android",
    "android:sync": "npm run build:android && node scripts/android-sync.mjs",
    "android:open": "cap open android",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview:demo": "node scripts/demo-server.mjs",
    "demo": "npm run build:demo && npm run preview:demo",
    "demo:package": "node scripts/prepare-demo.mjs",
    "demo:audit": "node scripts/release-audit.mjs",
    "test:demo": "node scripts/demo-release-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "local.focusspace.desktop",
    "productName": "FocusSpace",
    "directories": {
      "output": "release/0.2.7"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "build/icon.ico"
    }
  },
  "author": "Kristian Gaydov",
  "license": "SEE LICENSE IN LICENSE.txt"
}
